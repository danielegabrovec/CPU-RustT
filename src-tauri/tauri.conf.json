{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CPU-RustT",
  "version": "0.2.0",
  "identifier": "it.gabrovec.cpu-rustt",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "CPU-RustT · Monitor hardware", "width": 1440, "height": 940, "minWidth": 760, "minHeight": 580, "center": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Daniele Gabrovec",
    "copyright": "Copyright © 2026 Daniele Gabrovec",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": { "../LICENSE": "LICENSE", "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt" },
    "shortDescription": "Monitor CPU, memoria, GPU e sessioni locali",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Italian"], "displayLanguageSelector": false } }
  }
}
